# ─── Docker Compose Environment Variables ──────────────────────────
# Copy this file to .env.local for local overrides

# ─── MySQL Configuration ────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=librarymanagement
MYSQL_USER=library_user
MYSQL_PASSWORD=library_pass123
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ─── Redis Configuration ────────────────────────────────────────────
REDIS_PASSWORD=gQAAAAAAAaa3AAIgcDEzM2M2NzAwMmM4NWQ0YTcyODE1ZmJiNjI0MjY0OGYwOQ
REDIS_HOST=talented-ringtail-108215.upstash.io
REDIS_PORT=6379
REDIS_SSL_ENABLED=true

# ─── Spring Boot Configuration ──────────────────────────────────────
SPRING_APPLICATION_NAME=LibraryManagementSystem
SERVER_PORT=8080

# ─── JWT Configuration ──────────────────────────────────────────────
JWT_SECRET=LibraryManagementSystemSecretKey2026!!
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000
JWT_PREFIX=Bearer
JWT_HEADER=Authorization

# ─── Logging Configuration ──────────────────────────────────────────
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_ORG_EXAMPLE_LIBRARYMANAGEMENTSYSTEM=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO

# ─── JPA Configuration ──────────────────────────────────────────────
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# ─── Cache Configuration ────────────────────────────────────────────
SPRING_CACHE_TYPE=redis
SPRING_CACHE_REDIS_TIME_TO_LIVE=600000

# ─── Actuator Configuration ─────────────────────────────────────────
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=*
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
